                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/2/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users",
                "2",
                "status"
              ]
            }
          }
        },
        {
          "name": "Get All Bookings Across Platform",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/bookings?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "bookings"
              ]
            }
          }
        }
      ]
    }
  ]
}
